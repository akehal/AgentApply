# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit a real key.

# Required: your Anthropic API key (server-side only; never exposed to the browser).
ANTHROPIC_API_KEY=

# Required only if your API key is NOT scoped to a workspace (the API returns
# "must include the anthropic-workspace-id header"). Find the ID in the Claude
# Console under Settings → Workspaces.
# ANTHROPIC_WORKSPACE_ID=

# Optional: override the Claude model (defaults to claude-opus-5).
# ANTHROPIC_MODEL=claude-opus-5
